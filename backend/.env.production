# 安诊保 AI 副驾 — 生产环境配置
# 复制此文件为 .env.production 并填入真实值

# App
AZB_APP_NAME=安诊保 AI 副驾
AZB_APP_ENV=production
AZB_DEBUG=false
AZB_DEMO_MODE=false

# Database
AZB_DATABASE_URL=postgresql+asyncpg://abz_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/anzhenbao

# Redis
AZB_REDIS_URL=redis://redis:6379/0

# JWT（生产环境必须使用强密钥！）
AZB_JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
AZB_JWT_ALGORITHM=HS256
AZB_JWT_EXPIRE_MINUTES=120
AZB_REFRESH_EXPIRE_DAYS=7

# 反向代理信任（false=默认，只认 request.client.host；true=仅可信 Nginx 时开启）
AZB_TRUST_PROXY=false

# 演示/试点用户密码（正式 Internal Pilot / 生产必须改成强密码！）
# 生成: python -c "import secrets;print(secrets.token_urlsafe(24))"
AZB_DEMO_PASSWORD=CHANGE_ME_PILOT_STRONG_PASSWORD

# AI Provider
AZB_AI_PROVIDER=deepseek
AZB_AI_API_KEY=CHANGE_ME_API_KEY
AZB_AI_BASE_URL=https://api.deepseek.com/v1
AZB_AI_MODEL=deepseek-chat
AZB_AI_EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL
AZB_AI_RERANK_MODEL=CHANGE_ME_RERANK_MODEL_IF_USED

# Frontend
AZB_FRONTEND_URL=https://your-production-domain.com
