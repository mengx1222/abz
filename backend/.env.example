# ============================================
# 安诊保 AI 副驾 - 环境变量配置
# 所有变量使用 AZB_ 前缀
# ============================================

# --- App ---
AZB_APP_NAME=安诊保 AI 副驾
AZB_APP_ENV=development
AZB_DEBUG=true
AZB_DEMO_MODE=true

# --- Database (PostgreSQL + asyncpg) ---
AZB_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/anzhenbao

# --- Redis ---
AZB_REDIS_URL=redis://localhost:6379/0

# --- JWT ---
AZB_JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
AZB_JWT_ALGORITHM=HS256
AZB_JWT_EXPIRE_MINUTES=120
AZB_REFRESH_EXPIRE_DAYS=7

# --- AI Provider (mock / deepseek / qwen / openai) ---
AZB_AI_PROVIDER=mock
AZB_AI_API_KEY=
AZB_AI_BASE_URL=
AZB_AI_MODEL=
AZB_AI_EMBEDDING_MODEL=

# --- Frontend ---
AZB_FRONTEND_URL=http://localhost:3000
