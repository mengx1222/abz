# ============================================================
# 安诊保 AI 副驾 — 环境变量配置模板
# 复制本文件为 backend/.env 并根据实际环境修改对应值
# cp .env.example backend/.env
# ============================================================
# 注意：所有后端环境变量使用 AZB_ 前缀，避免与宿主环境冲突
# ============================================================

# -------------------- 应用基础配置 --------------------
AZB_APP_NAME=安诊保AI副驾
AZB_APP_ENV=development
AZB_DEBUG=true
AZB_DEMO_MODE=true

# -------------------- 数据库配置 --------------------
# Docker 环境
AZB_DATABASE_URL=postgresql+asyncpg://abz_user:abz_dev_2026@postgres:5432/anzhenbao
# 本地开发
# AZB_DATABASE_URL=postgresql+asyncpg://abz_user:abz_dev_2026@localhost:5432/anzhenbao

# -------------------- Redis 配置 --------------------
# Docker 环境
AZB_REDIS_URL=redis://redis:6379/0
# 本地开发
# AZB_REDIS_URL=redis://localhost:6379/0

# -------------------- JWT 认证配置 --------------------
AZB_JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
AZB_JWT_ALGORITHM=HS256
AZB_JWT_EXPIRE_MINUTES=120
AZB_REFRESH_EXPIRE_DAYS=7

# -------------------- 反向代理信任 --------------------
# false（默认）：客户端 IP 只取 request.client.host，忽略可伪造的 XFF/X-Real-IP；
# true：仅当部署前置可信 Nginx（strip 客户端 XFF + proxy_set_header X-Real-IP $remote_addr）时开启
AZB_TRUST_PROXY=false

# -------------------- 演示/试点用户密码 --------------------
# seed.py 演示用户密码（E2E/CI 默认 888888 仅测试用；正式 Internal Pilot / 生产
# 必须注入强密码，禁止沿用默认值上线）
AZB_DEMO_PASSWORD=888888

# -------------------- AI 模型配置 --------------------
AZB_AI_PROVIDER=mock
AZB_AI_API_KEY=
AZB_AI_BASE_URL=
AZB_AI_MODEL=
AZB_AI_EMBEDDING_MODEL=

# -------------------- 前端配置 --------------------
AZB_FRONTEND_URL=http://localhost:3000

# -------------------- Docker 专用 --------------------
POSTGRES_USER=abz_user
POSTGRES_PASSWORD=abz_dev_2026
POSTGRES_DB=anzhenbao
