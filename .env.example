# ============================================================
# 安诊保 AI 副驾 — 环境变量配置模板
# 复制本文件为 .env 并根据实际环境修改对应值
# cp .env.example .env
# ============================================================

# -------------------- 应用基础配置 --------------------
# 应用名称
APP_NAME=安诊保AI副驾
# 运行环境：development（开发）| staging（预发布）| production（生产）
APP_ENV=development
# 是否启用 Demo 模式（true 时预置演示数据，生产环境必须设为 false）
DEMO_MODE=true
# 应用密钥（用于加密签名等，至少 32 个随机字符，请务必修改）
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# -------------------- 数据库配置 --------------------
# SQLAlchemy 异步数据库连接字符串（Docker 环境使用 postgres 主机名）
DATABASE_URL=postgresql+asyncpg://abz_user:abz_dev_2026@postgres:5432/anzhenbao
# 本地开发直连时使用以下地址：
# DATABASE_URL=postgresql+asyncpg://abz_user:abz_dev_2026@localhost:5432/anzhenbao
# PostgreSQL 用户名
POSTGRES_USER=abz_user
# PostgreSQL 密码（生产环境请使用强密码）
POSTGRES_PASSWORD=abz_dev_2026
# PostgreSQL 数据库名
POSTGRES_DB=anzhenbao
# PostgreSQL 主机（Docker 内部使用服务名 postgres，本地使用 localhost）
POSTGRES_HOST=postgres
# PostgreSQL 端口
POSTGRES_PORT=5432

# -------------------- Redis 配置 --------------------
# Redis 连接地址（Docker 环境使用 redis 主机名）
REDIS_URL=redis://redis:6379/0
# 本地开发直连时使用：
# REDIS_URL=redis://localhost:6379/0
# Redis 主机
REDIS_HOST=redis
# Redis 端口
REDIS_PORT=6379
# Redis 数据库编号
REDIS_DB=0

# -------------------- JWT 认证配置 --------------------
# JWT 签名密钥（用于 Access Token 和 Refresh Token，请务必修改为强密钥）
JWT_SECRET_KEY=change-me-to-another-random-secret-key
# Access Token 有效期（小时），默认 2 小时
JWT_EXPIRE_HOURS=2
# Refresh Token 有效期（天），默认 7 天
REFRESH_EXPIRE_DAYS=7
# Demo 模式下 Access Token 有效期（小时），缩短为 1 小时
DEMO_JWT_EXPIRE_HOURS=1
# Demo 模式下 Refresh Token 有效期（天），缩短为 1 天
DEMO_REFRESH_EXPIRE_DAYS=1

# -------------------- AI 模型配置 --------------------
# AI Provider：mock（演示模式）| openai | deepseek | qwen | zhipu
AI_PROVIDER=mock
# AI API 密钥（连接真实模型服务时填写）
AI_API_KEY=sk-xxx
# AI 模型服务基础 URL
AI_BASE_URL=https://api.openai.com/v1
# 对话模型名称
AI_MODEL=gpt-4o
# 文本 Embedding 模型名称（用于 RAG 向量检索）
AI_EMBEDDING_MODEL=text-embedding-3-small
# 单次生成最大 Token 数
AI_MAX_TOKENS=4096
# 生成温度（0.0-1.0，越高越随机，越低越确定）
AI_TEMPERATURE=0.7
# RAG 检索返回的最大文档数
RAG_TOP_K=5
# RAG 检索相似度阈值（0.0-1.0）
RAG_SIMILARITY_THRESHOLD=0.7

# -------------------- 日志配置 --------------------
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志格式：json（结构化）| text（纯文本）
LOG_FORMAT=json

# -------------------- 文件上传配置 --------------------
# 文件上传存储目录
UPLOAD_DIR=/app/uploads
# 最大上传文件大小
MAX_UPLOAD_SIZE=50MB
# 允许上传的文件类型（MIME 白名单，逗号分隔）
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/gif,image/webp

# -------------------- 速率限制配置 --------------------
# 全局 IP 限流：每秒最大请求数
RATE_LIMIT_GLOBAL_IP=100/s
# 用户级限流：每分钟最大请求数
RATE_LIMIT_USER=200/min
# 登录接口限流：同一 IP 每分钟最大请求数
RATE_LIMIT_LOGIN=10/min
# AI 对话接口限流：同一用户每分钟最大请求数
RATE_LIMIT_AI_CHAT=10/min
# 文件上传接口限流：同一用户每分钟最大请求数
RATE_LIMIT_UPLOAD=5/min

# -------------------- 安全配置 --------------------
# 密码 bcrypt 迭代次数（最小 12）
BCRYPT_ROUNDS=12
# 登录失败锁定次数
LOGIN_MAX_ATTEMPTS=5
# 登录锁定时长（分钟）
LOGIN_LOCKOUT_MINUTES=30
# 验证码有效期（分钟）
VERIFY_CODE_EXPIRE_MINUTES=5
# 验证码最大验证次数
VERIFY_CODE_MAX_ATTEMPTS=5
# 单手机号每日验证码发送上限
SMS_DAILY_LIMIT_PER_PHONE=10

# -------------------- 前端配置 --------------------
# 前端 API 基础路径（Docker 环境通过 Nginx 代理，使用相对路径）
VITE_API_BASE_URL=/api
# 前端开发服务器端口
VITE_PORT=5173

# -------------------- 加密配置 --------------------
# 数据加密密钥（AES-256，用于敏感字段加密存储）
DATA_ENCRYPTION_KEY=change-me-to-a-32-byte-encryption-key

# -------------------- 通知配置 --------------------
# 企业微信 Webhook URL（可选，用于安全告警通知）
WECOM_WEBHOOK_URL=
# 钉钉 Webhook URL（可选，用于安全告警通知）
DINGTALK_WEBHOOK_URL=
